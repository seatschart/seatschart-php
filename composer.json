{
    "name": "seatschart/seatschart-php",
    "description": "Official SeatsChart PHP SDK for the SeatsChart seating API: seat maps, holds, reservations and ticketing inventory, with automatic retries and idempotency keys.",
    "type": "library",
    "keywords": [
        "seats",
        "seating chart",
        "ticketing",
        "seat map",
        "reservations"
    ],
    "homepage": "https://github.com/seatschart/seatschart-php",
    "license": "MIT",
    "authors": [
        {
            "name": "SeatsChart",
            "email": "seatschart@gmail.com",
            "homepage": "https://github.com/seatschart"
        }
    ],
    "support": {
        "email": "seatschart@gmail.com",
        "source": "https://github.com/seatschart/seatschart-php"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "SeatsChart\\Client\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SeatsChart\\Client\\Test\\": "test/"
        }
    }
}
